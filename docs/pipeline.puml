@startuml pipeline
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif

title DECIMER -> ONNX pipeline

|Build (TF)|
start
:1. Fetch weights\n(verify checksum);
:2. Probe / extract source;
:3. Export FP32 ONNX\n(encoder + decoder step);
if (FP32 parity vs TF OK?) then (yes)
else (no)
  :Report export/parity failure;
  goto fail
endif

|Quantize & select (ORT)|
:4. Build E1-E4 candidates\n(dyn/static INT8, hybrid, FP16);
repeat
  :Evaluate candidates\n(parity, golden, latency, size);

  |Validate & ship|
  if (quality gates pass?) then (yes)
    :Select default (selection.json);
    :6. Bundle runtime (no TF);
    :Runtime ready;
    stop
  else (no)
    |Quantize & select (ORT)|
    :Tune calibration / exclusions\nand rebuild candidates;
  endif
repeat while (rebuilt for re-evaluation?) is (yes) not (no)

|Validate & ship|
:Report: no candidate passed gates;
label fail
:Block release;
end
@enduml
